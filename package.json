{
  "name": "backgammon-roguelike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.server.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "gate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.1",
    "ioredis": "^6.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,html,md,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.15.1"
}
